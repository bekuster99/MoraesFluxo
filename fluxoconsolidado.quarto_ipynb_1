      "source": [
        "#| echo: false\n",
        "#| output: asis\n",
        "import pandas as pd\n",
        "import plotly.graph_objects as go\n",
        "# ==============================\n",
        "# Importar bases \n",
        "\n",
        "SaldoMS = pd.read_excel('SaldoMS.xlsx')\n",
        "SaldoMS['Data'] = pd.to_datetime(SaldoMS['Data'])\n",
        "SaldoSF = pd.read_excel('SaldoSF.xlsx')\n",
        "SaldoSF['Data'] = pd.to_datetime(SaldoSF['Data'])\n",
        "SaldoSB = pd.read_excel('SaldoSB.xlsx')\n",
        "SaldoSB['Data'] = pd.to_datetime(SaldoSB['Data'])\n",
        "\n",
        "# ==============================\n",
        "# Período\n",
        "# ==============================\n",
        "\n",
        "data_inicio = '2026-01-01'\n",
        "data_fim = '2026-07-31'\n",
        "\n",
        "\n",
        "# ==============================\n",
        "# Preparar dados\n",
        "# ==============================\n",
        "\n",
        "SaldoMS['Data'] = pd.to_datetime(SaldoMS['Data'])\n",
        "SaldoSB['Data'] = pd.to_datetime(SaldoSB['Data'])\n",
        "SaldoSF['Data'] = pd.to_datetime(SaldoSF['Data'])\n",
        "\n",
        "SaldoSF['Saldo Final'] = (\n",
        "    SaldoSF['Saldo Final']\n",
        "    .replace({r'R\\$': '', r'\\.': '', ',': '.'}, regex=True)\n",
        "    .astype(float)\n",
        ")\n",
        "\n",
        "\n",
        "# ==============================\n",
        "# Consolidar\n",
        "# ==============================\n",
        "\n",
        "df = pd.merge(\n",
        "    SaldoMS[['Data', 'Valor Banco']],\n",
        "    SaldoSB[['Data', 'Valor Banco']],\n",
        "    on='Data',\n",
        "    how='outer',\n",
        "    suffixes=('_MS', '_SB')\n",
        ")\n",
        "\n",
        "df = pd.merge(\n",
        "    df,\n",
        "    SaldoSF[['Data', 'Saldo Final']],\n",
        "    on='Data',\n",
        "    how='outer'\n",
        ")\n",
        "\n",
        "df = df.fillna(0)\n",
        "df = df.sort_values('Data')\n",
        "\n",
        "\n",
        "# ==============================\n",
        "# Filtrar período\n",
        "# ==============================\n",
        "\n",
        "df = df[\n",
        "    (df['Data'] >= data_inicio) &\n",
        "    (df['Data'] <= data_fim)\n",
        "].copy()\n",
        "\n",
        "# ==============================\n",
        "# Preparação do DataFrame para o Gráfico (Apenas último dia do mês)\n",
        "# ==============================\n",
        "# Criamos uma cópia para não alterar os dados brutos usados na tabela\n",
        "df_grafico = df.copy()\n",
        "df_grafico['AnoMes'] = df_grafico['Data'].dt.to_period('M')\n",
        "\n",
        "# Mantém apenas a última observação de cada mês para o gráfico\n",
        "df_grafico = df_grafico.groupby('AnoMes', as_index=False).last()\n",
        "\n",
        "# ==============================\n",
        "# Gráfico (Nomes fixos)\n",
        "# ==============================\n",
        "df_grafico = df.copy()\n",
        "df_grafico['AnoMes'] = df_grafico['Data'].dt.to_period('M')\n",
        "\n",
        "# Pega o último de cada mês\n",
        "df_grafico = df_grafico.groupby('AnoMes', as_index=False).last()\n",
        "\n",
        "# CRIA A COLUNA DE TEXTO FIXO\n",
        "# Garante a ordem correta definindo a lista na ordem cronológica\n",
        "nomes_meses = ['Janeiro', 'Fevereiro', 'Março', 'Abril', 'Maio', 'Junho', 'Julho']\n",
        "df_grafico['Mes_Texto'] = nomes_meses[:len(df_grafico)]\n",
        "\n",
        "fig = go.Figure()\n",
        "\n",
        "fig.add_trace(go.Bar(x=df_grafico['Mes_Texto'], y=df_grafico['Valor Banco_MS'], name='Moraes', marker_color='#1c7e9e'))\n",
        "fig.add_trace(go.Bar(x=df_grafico['Mes_Texto'], y=df_grafico['Valor Banco_SB'], name='SB', marker_color='#050d36'))\n",
        "fig.add_trace(go.Bar(x=df_grafico['Mes_Texto'], y=df_grafico['Saldo Final'], name='Fratelli', marker_color='#063605'))\n",
        "\n",
        "# ==============================\n",
        "# Layout\n",
        "# ==============================\n",
        "\n",
        "fig.update_layout(\n",
        "    barmode='stack',\n",
        "\n",
        "    title='Evolução Diária do Saldo',\n",
        "\n",
        "    xaxis_title='Data',\n",
        "    yaxis_title='Saldo',\n",
        "\n",
        "    hovermode='x unified',\n",
        "\n",
        "    legend_title='Empresa',\n",
        "\n",
        "    template='plotly_white',\n",
        "\n",
        "    height=500,\n",
        "\n",
        "    margin=dict(\n",
        "        l=60,\n",
        "        r=30,\n",
        "        t=70,\n",
        "        b=60\n",
        "    )\n",
        ")\n",
        "\n",
        "fig.update_yaxes(\n",
        "    tickprefix='R$ ',\n",
        "    separatethousands=True\n",
        ")\n",
        "\n",
        "fig.show()\n",
        "# ==============================\n",
        "# Geração de Caixa vs Investimentos vs Endividamento\n",
        "# ==============================\n",
        "\n",
        "# 1. Somar o saldo de todas as contas para obter o Saldo Total Diário\n",
        "df['Saldo_Total'] = df['Valor Banco_MS'] + df['Valor Banco_SB'] + df['Saldo Final']\n",
        "\n",
        "# 2. Criar coluna de mês/ano para agrupamento (padrão 'mai/26')\n",
        "traducao_meses = {'jan': 'jan', 'feb': 'fev', 'mar': 'mar', 'apr': 'abr', 'may': 'mai', 'jun': 'jun', 'jul': 'jul', 'aug': 'ago', 'sep': 'set', 'oct': 'out', 'nov': 'nov', 'dec': 'dez'}\n",
        "df['Mes_Ref'] = df['Data'].dt.strftime('%b').str.lower().map(traducao_meses) + df['Data'].dt.strftime('/%y')\n",
        "\n",
        "# 3. Isolar o primeiro e último dia de cada mês\n",
        "df_caixa = df.groupby('Mes_Ref', sort=False).agg(\n",
        "    Saldo_Inicial=('Saldo_Total', 'first'),\n",
        "    Saldo_Final=('Saldo_Total', 'last')\n",
        ").reset_index()\n",
        "\n",
        "# 4. Calcular Geração de Caixa (Final - Inicial)\n",
        "df_caixa['Geracao_Caixa'] = df_caixa['Saldo_Final'] - df_caixa['Saldo_Inicial']\n",
        "\n",
        "# 5. Mapear os totais investidos e endividamento\n",
        "### INCLUIR GERAÇÃO DE CAIXA BRUTA QUE É A GERAÇÃO DE CAIXA + INVESTIMENTOS + QUITAÇÃO DE ENDIVIDAMENTO #####\n",
        "dados_investimentos = {\n",
        "    'jan/26': -143699.79,\n",
        "    'fev/26': -751923.29,\n",
        "    'mar/26': -157220.02, \n",
        "    'abr/26': -1039630.61,\n",
        "    'mai/26': -617344.50,\n",
        "    'jun/26': -135621.58,\n",
        "    'jul/26': -72310.94\n",
        "}\n",
        "\n",
        "dados_endividamento = {\n",
        "    'jan/26': -549879.65,\n",
        "    'fev/26': -553761.28,\n",
        "    'mar/26': -512100.13,\n",
        "    'abr/26': -489598.08,\n",
        "    'mai/26': -485498.74,\n",
        "    'jun/26': -483714.23,\n",
        "    'jul/26': -586225.33\n",
        "}\n",
        "\n",
        "df_caixa['Total_Investido'] = df_caixa['Mes_Ref'].map(dados_investimentos)\n",
        "df_caixa['Quitacao_Endividamento'] = df_caixa['Mes_Ref'].map(dados_endividamento)\n",
        "\n",
        "# 5.1 Calcular Geração de Caixa Bruta (Geração de Caixa + Investimentos + Quitação de Endividamento)\n",
        "# Os valores de investimentos e endividamento já são negativos, então subtraímos para reverter o efeito\n",
        "df_caixa['Geracao_Caixa_Bruta'] = (\n",
        "    df_caixa['Geracao_Caixa']\n",
        "    - df_caixa['Total_Investido']\n",
        "    - df_caixa['Quitacao_Endividamento']\n",
        ")\n",
        "\n",
        "# 6. Formatação monetária rigorosa com espaço não separável (\\u00A0)\n",
        "colunas_financeiras = ['Saldo_Inicial', 'Saldo_Final', 'Geracao_Caixa', 'Geracao_Caixa_Bruta', 'Total_Investido', 'Quitacao_Endividamento']\n",
        "\n",
        "for col in colunas_financeiras:\n",
        "    df_caixa[col] = df_caixa[col].apply(\n",
        "        lambda x: f\"R$\\u00A0{x:,.2f}\".replace(',', 'X').replace('.', ',').replace('X', '.') if pd.notnull(x) else \"-\"\n",
        "    )\n",
        "\n",
        "# 7. Renderizar a tabela em Markdown nativo\n",
        "print(\"\\n<br>\\n\")\n",
        "print(\"## Resumo: Geração de Caixa, Investimentos e Endividamento\\n\")\n",
        "md_table = \"| Mês | Saldo Inicial | Saldo Final | Geração de Caixa | Geração de Caixa Bruta | Total Investido | Quitação Endividamento |\\n\"\n",
        "md_table += \"| :--- | :--- | :--- | :--- | :--- | :--- | :--- |\\n\"\n",
        "\n",
        "for _, row in df_caixa.iterrows():\n",
        "    md_table += (\n",
        "        f\"| {row['Mes_Ref']} \"\n",
        "        f\"| {row['Saldo_Inicial']} \"\n",
        "        f\"| {row['Saldo_Final']} \"\n",
        "        f\"| {row['Geracao_Caixa']} \"\n",
        "        f\"| {row['Geracao_Caixa_Bruta']} \"\n",
        "        f\"| {row['Total_Investido']} \"\n",
        "        f\"| {row['Quitacao_Endividamento']} |\\n\"\n",
        "    )\n",
        "\n",
        "print(md_table)"
      ],
