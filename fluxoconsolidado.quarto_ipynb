{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Fluxo de Caixa Consolidado - Sagrada Familia"
      ],
      "id": "a4fb0271"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: false\n",
        "#| output: asis\n",
        "import pandas as pd\n",
        "import plotly.graph_objects as go\n",
        "# ==============================\n",
        "# Importar bases \n",
        "\n",
        "SaldoMS = pd.read_excel('SaldoMS.xlsx')\n",
        "SaldoMS['Data'] = pd.to_datetime(SaldoMS['Data'])\n",
        "SaldoSF = pd.read_excel('SaldoSF.xlsx')\n",
        "SaldoSF['Data'] = pd.to_datetime(SaldoSF['Data'])\n",
        "SaldoSB = pd.read_excel('SaldoSB.xlsx')\n",
        "SaldoSB['Data'] = pd.to_datetime(SaldoSB['Data'])\n",
        "\n",
        "# ==============================\n",
        "# Período\n",
        "# ==============================\n",
        "\n",
        "data_inicio = '2026-01-01'\n",
        "data_fim = '2026-01-31'\n",
        "\n",
        "\n",
        "# ==============================\n",
        "# Preparar dados\n",
        "# ==============================\n",
        "\n",
        "SaldoMS['Data'] = pd.to_datetime(SaldoMS['Data'])\n",
        "SaldoSB['Data'] = pd.to_datetime(SaldoSB['Data'])\n",
        "SaldoSF['Data'] = pd.to_datetime(SaldoSF['Data'])\n",
        "\n",
        "SaldoSF['Saldo Final'] = (\n",
        "    SaldoSF['Saldo Final']\n",
        "    .replace({'R\\$': '', '\\.': '', ',': '.'}, regex=True)\n",
        "    .astype(float)\n",
        ")\n",
        "\n",
        "\n",
        "# ==============================\n",
        "# Consolidar\n",
        "# ==============================\n",
        "\n",
        "df = pd.merge(\n",
        "    SaldoMS[['Data', 'Valor Banco']],\n",
        "    SaldoSB[['Data', 'Valor Banco']],\n",
        "    on='Data',\n",
        "    how='outer',\n",
        "    suffixes=('_MS', '_SB')\n",
        ")\n",
        "\n",
        "df = pd.merge(\n",
        "    df,\n",
        "    SaldoSF[['Data', 'Saldo Final']],\n",
        "    on='Data',\n",
        "    how='outer'\n",
        ")\n",
        "\n",
        "df = df.fillna(0)\n",
        "df = df.sort_values('Data')\n",
        "\n",
        "\n",
        "# ==============================\n",
        "# Filtrar período\n",
        "# ==============================\n",
        "\n",
        "df = df[\n",
        "    (df['Data'] >= data_inicio) &\n",
        "    (df['Data'] <= data_fim)\n",
        "].copy()\n",
        "\n",
        "\n",
        "# ==============================\n",
        "# Gráfico\n",
        "# ==============================\n",
        "\n",
        "fig = go.Figure()\n",
        "fig.add_trace(go.Bar(\n",
        "    x=df['Data'],\n",
        "    y=df['Valor Banco_MS'],\n",
        "    name='Moraes',\n",
        "    marker_color='#1c7e9e',\n",
        "    hovertemplate=\n",
        "        '<b>Moraes</b><br>' +\n",
        "        'Data: %{x|%d/%m/%Y}<br>' +\n",
        "        'Saldo: R$ %{y:,.2f}' +\n",
        "        '<extra></extra>'\n",
        "))\n",
        "\n",
        "fig.add_trace(go.Bar(\n",
        "    x=df['Data'],\n",
        "    y=df['Valor Banco_SB'],\n",
        "    name='SB',\n",
        "    marker_color='#050d36',\n",
        "    hovertemplate=\n",
        "        '<b>SB</b><br>' +\n",
        "        'Data: %{x|%d/%m/%Y}<br>' +\n",
        "        'Saldo: R$ %{y:,.2f}' +\n",
        "        '<extra></extra>'\n",
        "))\n",
        "\n",
        "fig.add_trace(go.Bar(\n",
        "    x=df['Data'],\n",
        "    y=df['Saldo Final'],\n",
        "    name='Fratelli',\n",
        "    marker_color='#063605',\n",
        "    hovertemplate=\n",
        "        '<b>Fratelli</b><br>' +\n",
        "        'Data: %{x|%d/%m/%Y}<br>' +\n",
        "        'Saldo: R$ %{y:,.2f}' +\n",
        "        '<extra></extra>'\n",
        "))\n",
        "\n",
        "\n",
        "# ==============================\n",
        "# Layout\n",
        "# ==============================\n",
        "\n",
        "fig.update_layout(\n",
        "    barmode='stack',\n",
        "\n",
        "    title='Evolução Diária do Saldo',\n",
        "\n",
        "    xaxis_title='Data',\n",
        "    yaxis_title='Saldo',\n",
        "\n",
        "    hovermode='x unified',\n",
        "\n",
        "    legend_title='Empresa',\n",
        "\n",
        "    template='plotly_white',\n",
        "\n",
        "    height=500,\n",
        "\n",
        "    margin=dict(\n",
        "        l=60,\n",
        "        r=30,\n",
        "        t=70,\n",
        "        b=60\n",
        "    )\n",
        ")\n",
        "\n",
        "fig.update_yaxes(\n",
        "    tickprefix='R$ ',\n",
        "    separatethousands=True\n",
        ")\n",
        "\n",
        "fig.show()"
      ],
      "id": "dbe63cd1",
      "execution_count": null,
      "outputs": []
    }
  ],
